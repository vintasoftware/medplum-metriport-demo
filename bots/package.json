{
  "name": "medplum-metriport-bots",
  "version": "0.0.1",
  "private": true,
  "description": "Medplum Bots for the Metriport integration",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc && node --no-warnings esbuild-script.mjs",
    "clean": "rimraf dist",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@medplum/bot-layer": "5.1.36",
    "@medplum/cli": "5.1.36",
    "@medplum/core": "5.1.36",
    "@medplum/fhirtypes": "5.1.36",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "fast-glob": "3.3.3",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  }
}
