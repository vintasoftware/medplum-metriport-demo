# Medplum CLI credentials, used by `npm run deploy`.
# Not needed if you authenticate with `npx medplum login` instead.
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Metriport configuration. These are NOT read from this file: set them as Medplum project secrets
# (app.medplum.com -> Project Admin -> Secrets), which is where the bot reads them at run time.
# Listed here so the required set is in one place.
#
# METRIPORT_API_KEY                    required, must match the environment below
# METRIPORT_ENV                        sandbox (default) | production
# METRIPORT_TOKEN_EXPIRATION_SECONDS   default 900, max 36000
